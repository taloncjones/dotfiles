#!/usr/bin/env bash
# dotfiles-tests - Run every dotfiles test suite and report one verdict.
#
# The repo's tests are standalone shell scripts with no shared runner; before
# this script they only ran when a human remembered the right eight commands.
# This is the single entrypoint for all of them (and what CI runs). Each suite
# prints its own PASS/FAIL lines; this runner adds a per-suite verdict and a
# final summary, and exits non-zero if any suite failed.
#
# Usage: dotfiles-tests            run all suites
#        dotfiles-tests --list     list suites without running

set -u

# The suites are hermetic against real STATE but were not hermetic against the
# caller's ENVIRONMENT. Any account selector makes account_scope ignore
# CLAUDE_CONFIG_DIR and resolve account_root to a real account dir, which is
# not where any fixture lives -- so a plain local run produced dozens of
# failures that a scrubbed run did not, and the standing workaround was to
# remember the flag. CI never sets these, so unsetting here is also what makes
# a local run mean the same thing as the CI run.
#
# The WHOLE table, not the two that were noticed first. CLAUDE_PERSONAL_ONLY
# outranks CLAUDE_CONFIG_DIR and is the one this repo's own CLAUDE.md tells
# the user to export, so leaving it set took the guard suite from 237/0 to
# 179/58 -- and the red cases reported rc=0 where a deny was asserted, so a
# genuine fail-open regression would have been indistinguishable from
# environment noise. The rest relocate a root or a scope id the same way.
unset WORKFLOW_PERSONAL_ACCOUNT HERDR_PERSONAL CLAUDE_PERSONAL_ONLY
unset CLAUDE_WORK_TREE CLAUDE_WORK_CONFIG_DIR CODEX_HOME XDG_STATE_HOME

SCRIPT_DIR="$( cd -P "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
DOTFILES="$( cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd )"
cd "$DOTFILES"

# Snapshot for the litter check at the end. Captured before any suite runs so
# uncommitted work in progress is the baseline rather than a false positive.
before_status=$(git status --porcelain 2>/dev/null || true)

# interpreter<space>path, relative to repo root. Keep in sync when adding a
# *.test.sh or a skill test; grep -rl 'passed, .* failed' is a quick audit.
SUITES="
sh install/install.test.sh
sh bin/remote-access-doctor.test.sh
sh bin/zed-claude-agent.test.sh
sh bin/token-burn.test.sh
sh bin/herdr-zed-attach.test.sh
sh install/zshenv-migrate.test.sh
sh zsh/functions.test.sh
sh zsh/claude-account.test.sh
sh zsh/codex-account.test.sh
sh claude/hooks/claude-hooks.test.sh
sh claude/hooks/plan-canvas-isolation.test.sh
sh claude/hooks/ecc-hook-isolation.test.sh
sh claude/hooks/gateguard-tuning.test.sh
sh claude/hooks/herdr-capabilities.test.sh
sh claude/hooks/herdr-orch.test.sh
sh claude/hooks/herdr-orch-contract.test.sh
sh claude/hooks/herdr-coordination.test.sh
sh claude/hooks/herdr-stop-gate.test.sh
bash claude/hooks/agent-runtime.test.sh
bash claude/hooks/herdr-dispatch.test.sh
sh claude/hooks/scratch-policy.test.sh
sh claude/hooks/orch-edit-guard.test.sh
sh claude/hooks/git-remote-guard.test.sh
sh codex/hooks/codex-hooks.test.sh
sh codex/skills/codex-skills.test.sh
sh git/hooks/commit-msg.test.sh
sh git/hooks/post-checkout.test.sh
sh git/hooks/post-checkout-runtime.test.sh
sh git/hooks/pre-commit.test.sh
sh git/hooks/pre-push.test.sh
sh git/hooks/public-safety.test.sh
bash claude/skills/lib/test_work_state.sh
sh claude/skills/lib/workflow-context.test.sh
sh claude/skills/handoff/scripts/tests/handoff_test.sh
sh claude/hooks/handoff-notice.test.sh
sh claude/skills/co-review/scripts/tests/review_test.sh
bash claude/skills/todos/scripts/tests/todos_test.sh
bash claude/skills/todos/scripts/tests/todos_dashboard_test.sh
bash claude/skills/repo-recall/scripts/tests/recall_test.sh
bash claude/skills/voice/scripts/tests/voice_test.sh
sh install/claude-links.test.sh
sh install/codex-surfaces.test.sh
sh install/codex-roles.test.sh
sh install/codex-stop-hook.test.sh
sh install/ai-update.test.sh
sh install/repo-sync.test.sh
sh claude/hooks/settings-drift-check.test.sh
"

if [ "${1:-}" = "--list" ]; then
    printf '%s\n' "$SUITES" | sed '/^$/d'
    exit 0
fi

pass=0
fail=0
failed_suites=""

while read -r interp path; do
    [ -n "${path:-}" ] || continue
    if [ ! -f "$path" ]; then
        echo "[X] MISSING $path"
        fail=$((fail + 1))
        failed_suites="$failed_suites $path"
        continue
    fi
    echo "=== $path"
    if "$interp" "$path"; then
        echo "[OK] $path"
        pass=$((pass + 1))
    else
        echo "[X] FAILED $path"
        fail=$((fail + 1))
        failed_suites="$failed_suites $path"
    fi
    echo
done <<EOF
$SUITES
EOF

# Did a suite litter the checkout? Compared against the snapshot taken before
# the loop, not against "clean", because running this with uncommitted work is
# normal. A suite that redirects to a bare relative path writes into whatever
# cwd the runner has, which is the repo root -- and one such file reached a
# commit via `git add -A`. Its content was a test's stderr, which a different
# failure could make carry a temp path or an account id. Diffing the status
# catches that for every suite rather than for one filename.
after_status=$(git status --porcelain 2>/dev/null || true)
if [ "$after_status" != "$before_status" ]; then
    echo "[X] a suite changed the working tree:"
    printf '%s\n' "$after_status" | while IFS= read -r line; do
        [ -n "$line" ] || continue
        printf '%s\n' "$before_status" | grep -qxF "$line" || printf '    %s\n' "$line"
    done
    fail=$((fail + 1))
    failed_suites="$failed_suites working-tree-litter"
fi

echo "=== dotfiles-tests: $pass suites passed, $fail failed"
if [ "$fail" -ne 0 ]; then
    echo "[X] Failing suites:$failed_suites"
    exit 1
fi
