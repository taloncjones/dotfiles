#!/usr/bin/env bash
set -euo pipefail

# Global commit-msg guard for portable commit message policy.
#
# Three layers, in order:
#   1. Strip pass (no rg needed): removes agent attribution lines that tools
#      inject -- agent co-author trailers (by name, noreply mailbox, or [bot]
#      address), session and generated-with/by trailer keys, and
#      "Generated with|by <agent>" footers -- from line 2 onward. Other line
#      content is preserved; rewriting adds LF to an unterminated retained
#      final line. A message with nothing to strip is not rewritten at all.
#   2. Subject length (no rg needed): rejects a first line of 75 or more
#      characters unless git generated it (merge, revert, autosquash).
#   3. Block checks (rg): reject what cannot be safely edited -- inline
#      attribution in the subject or body, and emojis.
# Agent names come from agent-tokens next to this hook, which the Bash
# attribution hooks under claude/ and codex/ read too.
# Squash-merge messages come from the PR body, which no git hook sees; the
# PR-side opt-out lives in claude/settings.json.tmpl (attribution.pr).

if [[ "${DOTFILES_SKIP_COMMIT_MSG_GUARD:-0}" == "1" ]]; then
  exit 0
fi

message_file="${1:-}"
if [[ -z "$message_file" || ! -f "$message_file" ]]; then
  exit 0
fi

# --- Strip pass --------------------------------------------------------------

for tool in awk grep sed cat mktemp mv rm; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'commit-msg: %s not found; refusing to commit unchecked.\n' "$tool" >&2
    exit 1
  fi
done

# git runs the hook through the linked hooks directory, so the token file is
# reachable as a sibling without resolving symlinks.
hook_dir="${BASH_SOURCE[0]%/*}"
if [[ "$hook_dir" == "${BASH_SOURCE[0]}" ]]; then
  hook_dir="."
fi
tokens_file="$hook_dir/agent-tokens"
if ! agent_alt="$(LC_ALL=C awk '
    !/^[a-z0-9]+$/ { bad = 1; exit }
    { alt = alt (NR > 1 ? "|" : "") $0 }
    END { if (bad || NR == 0) exit 1; print alt }
  ' "$tokens_file" 2>/dev/null)"; then
  printf 'commit-msg: %s is missing, empty, or invalid; refusing to commit unchecked.\n' "$tokens_file" >&2
  exit 1
fi

# The block rule below needs "aider" (collides with surnames like Raider) to
# require a leading boundary while every other token stays a plain substring
# match, so split the list once here.
agent_alt_bounded=""
agent_alt_substring=""
IFS='|' read -r -a agent_token_list <<<"$agent_alt"
for agent_token in "${agent_token_list[@]}"; do
  if [[ "$agent_token" == "aider" ]]; then
    agent_alt_bounded="$agent_token"
  else
    agent_alt_substring="${agent_alt_substring:+${agent_alt_substring}|}${agent_token}"
  fi
done

# Lowercase POSIX ERE, matched against tolower($0) so BSD and GNU awk agree on
# case-insensitivity. Bracket classes only: no \b, no \s, no backslash escapes.
# Whole-word only: a token glued to another word (ClaudeBot, AutoGPT) is left
# for the block rule below, which refuses it instead of silently stripping it.
re_coauthor="^[[:space:]]*co-authored-by:(.*[^[:alnum:]])?(${agent_alt})([^[:alnum:]]|$)"
re_bot_coauthor='^[[:space:]]*co-authored-by:.*<(no-?reply@|[^>]*[[]bot[]]@)'
re_session="^[[:space:]]*((${agent_alt})-session:|session:|[a-z-]*session[a-z-]*:[[:space:]]*https?://)"
re_generated_key='^[[:space:]]*generated-(with|by):'
re_footer="^[^[:alnum:]]*generated[[:space:]]+(with|by)[^[:alnum:]]*(${agent_alt}|ai)([^[:alnum:]]|$)"
re_strip="${re_coauthor}|${re_bot_coauthor}|${re_session}|${re_generated_key}|${re_footer}"

# Line 1 (the subject) is never stripped. LC_ALL=C makes emoji bytes count as
# non-alphanumeric for the footer prefix.
count_agent_lines() {
  LC_ALL=C awk -v re="$re_strip" '
    NR == 1 { next }
    tolower($0) ~ re { n++ }
    END { print n + 0 }
  ' "$1"
}

write_without_agent_lines() {
  LC_ALL=C awk -v re="$re_strip" '
    NR == 1 { print; next }
    tolower($0) ~ re { next }
    { print }
  ' "$1" > "$2"
}

strip_tmp=""
cleanup_strip_tmp() {
  if [[ -n "$strip_tmp" ]]; then
    rm -f "$strip_tmp"
  fi
}
trap cleanup_strip_tmp EXIT

agent_lines="$(count_agent_lines "$message_file")"
if [[ "$agent_lines" -gt 0 ]]; then
  message_dir="${message_file%/*}"
  if [[ "$message_dir" == "$message_file" ]]; then
    message_dir="."
  fi
  if ! strip_tmp="$(mktemp "${message_dir}/.commit-msg.XXXXXX")"; then
    printf 'commit-msg: cannot create a temp file in %s; refusing to commit unchecked.\n' "$message_dir" >&2
    exit 1
  fi
  if ! write_without_agent_lines "$message_file" "$strip_tmp"; then
    printf 'commit-msg: failed to write the stripped message; refusing to commit unchecked.\n' >&2
    exit 1
  fi
  if ! mv -f "$strip_tmp" "$message_file"; then
    printf 'commit-msg: failed to replace %s; refusing to commit unchecked.\n' "$message_file" >&2
    exit 1
  fi
  strip_tmp=""
  printf 'commit-msg: stripped %s agent attribution line(s).\n' "$agent_lines" >&2
fi

# --- Subject length -----------------------------------------------------------

# Bytes, not characters: equal for the ASCII subjects the repo rules require,
# and stricter otherwise. Git-generated subjects are exempt.
subject="$(LC_ALL=C awk 'NR == 1 { sub(/[[:space:]]+$/, ""); print; exit }' "$message_file")"
subject_len="$(printf '%s' "$subject" | LC_ALL=C awk '{ n += length($0) } END { print n + 0 }')"
# The [^ ]*[/:] branch covers "Merge <url>" and "Merge <path>".
re_generated_subject='^(Merge ((branch|branches|remote-tracking branch|remote-tracking branches|tag|tags|commit|commits|pull request) |[^ ]*[/:])|Revert "|Reapply "|(fixup|squash|amend)! )'
if [[ "$subject_len" -ge 75 && ! "$subject" =~ $re_generated_subject ]]; then
  printf 'commit-msg: subject is %s characters; keep it under 75.\n' "$subject_len" >&2
  exit 1
fi

# --- Block checks ------------------------------------------------------------

if ! command -v rg >/dev/null 2>&1; then
  printf 'commit-msg: rg not found; skipping attribution and emoji checks.\n' >&2
  exit 0
fi

message="$(cat "$message_file")"

# Permit directory/tool scopes like "claude:" while checking the summary/body.
body="$(printf '%s\n' "$message" | sed -E '1s/^[A-Za-z0-9_-]+:[[:space:]]*//')"

if printf '%s\n' "$body" | rg -qi "generated[[:space:]]+(by|with)[[:space:]]+(${agent_alt}|ai)|written[[:space:]]+by[[:space:]]+(${agent_alt}|ai)|created[[:space:]]+by[[:space:]]+(${agent_alt}|ai)|ai[- ]generated|generated[- ]by[- ]ai"; then
  printf 'Blocked: commit message contains tool-attribution terms.\n' >&2
  printf 'Remove attribution from the commit message.\n' >&2
  exit 1
fi

# Substring match for most tokens, so a glued prefix (AutoGPT) or a glued
# suffix (ClaudeBot) still blocks; only "aider" gets a leading boundary so a
# surname (Raider) passes.
block_tokens="$agent_alt_substring"
if [[ -n "$agent_alt_bounded" ]]; then
  block_tokens="${block_tokens}|\\b(${agent_alt_bounded})"
fi
if printf '%s\n' "$message" | rg -qi "co-authored-by:.*(${block_tokens}|ai\\b)"; then
  printf 'Blocked: commit message contains an AI/tool co-author line.\n' >&2
  exit 1
fi

if printf '%s\n' "$message" | rg -q '[\x{1F1E0}-\x{1F1FF}\x{1F300}-\x{1FAFF}\x{2600}-\x{27BF}]'; then
  printf 'Blocked: commit message contains emojis.\n' >&2
  exit 1
fi

exit 0
