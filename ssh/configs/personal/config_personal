Host Git-Personal
    HostName github.com
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentityFile ~/.ssh/id_ed25519_git_fallback
    IdentitiesOnly yes
    User git

# Bare github.com connections are personal by definition: work repos are
# rewritten to the Git-work alias by url.insteadOf in ~/.gitconfig-work.
# Pinning here stops the 1Password agent from ever offering the work key
# to a personal clone (key offer order no longer matters).
Host github.com
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentityFile ~/.ssh/id_ed25519_git_fallback
    IdentitiesOnly yes
    User git

# id_ed25519_git_fallback is a machine-local, GitHub-only on-disk key so git
# keeps working while the Mac (and therefore the 1Password vault/agent) is
# locked: the agent offers no keys when locked, and ssh falls through to this
# file. The 1Password-held personal key is listed first and wins whenever the
# vault is unlocked. The key is never tracked; ssh silently skips a missing
# IdentityFile on machines without it.
